# Plant3D-Web 环境配置示例
# 复制此文件为 .env.development 或 .env.production 并填入实际值
#
# 2026-09-20 起前端只有一个后端：gen-model（aios-database，缺省 :8022）。
# 模型树 / 三维模型走 /api/v1，校审 / 认证 / 用户走同源 /api/review /api/auth /api/users，附件走 /files/review_attachments。
# 旧后端 plant-model-gen（:3100 + parquet / DuckDB-WASM / SurrealDB 直连）已退役，相关变量一并删除。

# ---- gen-model /api/v1（模型树 + 三维模型；plan docs/plans/2026-09-06-gen-model-v1-*.md）----
# 缺省留空：
# - dev 自动直连 http://localhost:8022；
# - production 自动同源请求 /api/v1/*（nginx 把 /api 反代到 gen-model）。
# dev 写成 /gm 才走 Vite 代理；独立生产站点写远端绝对 URL。禁止把 localhost:8022 烘焙进生产包。
# URL 参数 ?gm_backend= / ?gm_backend_port= 始终最高优先。
VITE_GEN_MODEL_V1_BASE_URL=
# /gm 代理与同源 /api 代理的上游（仅 dev）；缺省取上面的绝对地址，再缺省 http://localhost:8022
# VITE_GEN_MODEL_V1_PROXY_TARGET=http://localhost:8022

# ---- 仅开发环境的数据回退 ----
# 缺省在 dev 开启，便于离线调试；写 false 可让开发环境也按生产方式直接报错。
# production 构建无条件禁用，即使误配 true 也不会使用 mock/demo 数据。
# REVIEW：校审用户/审核人/任务接口失败时的本地 mock，以及「本地模拟模式」开关。
# VITE_REVIEW_ALLOW_MOCK_FALLBACK=false
