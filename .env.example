# Plant3D-Web 环境配置示例
# 复制此文件为 .env.development 或 .env.production 并填入实际值

# SurrealDB 数据库连接配置
# WebSocket URL（Surreal 2.x 常用 /rpc 后缀；端口与服务器 surreal 监听一致）
# 本地示例: ws://localhost:8020/rpc
# 生产: 见 plant-model-gen/shells/run_surrealdb_kv_8020.sh（默认 8020）
VITE_SURREAL_URL=ws://localhost:8020/rpc
# 命名空间
VITE_SURREAL_NS=1516
# 数据库名
VITE_SURREAL_DB=AvevaMarineSample
# 用户名
VITE_SURREAL_USER=root
# 密码
VITE_SURREAL_PASS=root

# ---- gen-model /api/v1（模型树 + 三维模型的新数据源；plan docs/plans/2026-09-06-gen-model-v1-*.md）----
# 直连地址（gen-model DbOption.toml 的 http_api_addr，CORS 已放开，不必绕代理）。
# 写成 /gm 则走 Vite 同源代理（见 vite.config.ts 的 /gm 条目）。URL 参数 ?gm_backend= / ?gm_backend_port= 可覆盖。
VITE_GEN_MODEL_V1_BASE_URL=http://localhost:8022
# /gm 代理的上游（仅 dev）；缺省取上面的绝对地址，再缺省 http://localhost:8022
# VITE_GEN_MODEL_V1_PROXY_TARGET=http://localhost:8022
# 模型树 / 三维模型数据源开关：gen-model-v1（默认，2026-09-09 起）| legacy（旧后端 :3100 + parquet，保留一个发布周期）；URL ?model_source= 可覆盖
# VITE_MODEL_SOURCE=gen-model-v1
