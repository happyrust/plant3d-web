!traceFile = object FILE('D:/work/plant-code/old/plant3d-web/docs/verification/e3d-measurement-runtime-golden/G4-02-real-point-to-plane.trace.txt')
!trace = ARRAY()

!pick = !!edgCntrl.pickData
!positionData = !pick.positionData()
!dimension = !!gphMeasure.dimension
!from = !dimension.from
!to = !dimension.to
!distance = !from.distance(!to)
!vertical = abs(!from.wrt(world).up - !to.wrt(world).up)
!horizontal = sqrt(!distance * !distance - !vertical * !vertical)
!direction = !from.direction(!to).wrt(!dimension.wrt)

!trace.append('case=G4-02 real pick')
!trace.append('provider=registered GPHPLANE picked through EDG on its outline; source picked on GPHPOSITION aid')
!trace.append('source_aid=' & !!goldenPerpSourceAid2.string())
!trace.append('target_aid=' & !!goldenPerpPlaneAid.string())
!trace.append('last_pick_type=' & !pick.type)
!trace.append('last_pick_aid_type=' & !pick.aidType)
!trace.append('last_pick_aid_number=' & !pick.point.string())
!trace.append('position_data_type=' & !positionData.type)
!trace.append('position_data_original_type=' & !positionData.originalType)
!trace.append('position_data_position=' & !positionData.position.string())

!targetLine = !positionData.getLine()
handle any
  !trace.append('target_getLine_error=' & !!error.text)
elsehandle none
  !trace.append('target_getLine_set=' & !targetLine.set().string())
endhandle
!targetPlane = !positionData.getPlane()
handle any
  !trace.append('target_getPlane_error=' & !!error.text)
elsehandle none
  if (!targetPlane.set()) then
    !trace.append('target_plane_status=set')
    !trace.append('target_plane_position=' & !targetPlane.position.string())
    !trace.append('target_plane_normal=' & !targetPlane.direction().string())
  else
    !trace.append('target_plane_status=unset')
  endif
endhandle

!trace.append('wrt=' & !dimension.wrt.name)
!trace.append('result_from=' & !from.string())
!trace.append('result_to=' & !to.string())
!trace.append('distance_db=' & !distance.dbUnits().value().string())
!trace.append('distance_text=' & !distance.string(!!gphMeasure.measureFormat))
!trace.append('vertical_db=' & !vertical.dbUnits().value().string())
!trace.append('vertical_text=' & !vertical.string(!!gphMeasure.measureFormat))
!trace.append('horizontal_db=' & !horizontal.dbUnits().value().string())
!trace.append('horizontal_text=' & !horizontal.string(!!gphMeasure.measureFormat))
!trace.append('direction_text=' & !direction.string().before('WRT').trim())
!trace.append('perpendicular=' & !!gphMeasure.perpendicularTo.val.string() & ' wrt_gadget_active=' & !!gphMeasure.wrt.active.string())
!trace.append('complete')
!traceFile.writeFile('OVERWRITE', !trace)
return
