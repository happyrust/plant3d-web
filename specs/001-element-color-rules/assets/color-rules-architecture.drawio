<mxfile host="app.diagrams.net" agent="plant3d-web spec kit" version="24.0.0">
  <diagram id="color-rules-arch" name="Color Rules Architecture">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="构件颜色规则（Element Color Rules / AutoColour）— 解析架构" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="src" value="实例数据 (DuckDB/Parquet)&#10;uniforms: refno, noun, owner_noun, spec_value&#10;[purpose, name — 待补列]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="apply" value="applyMaterialConfigToLoadedDtx()&#10;（着色总入口，遍历 refno→objectIds）&#10;+ (noun|owner|spec|purpose) 记忆化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="resolve" value="resolveMaterialWithRules(config, ctx, theme)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="dec" value="colorRulesEnabled !== false ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="80" y="410" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="match" value="matchColorRule(rules, ctx)&#10;有序遍历，首条命中即返回&#10;(first-match)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="405" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="hit" value="命中：规则颜色/透明度/隐藏&#10;未指定字段回退 base 解析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="360" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="fallback" value="未命中 / 关闭：&#10;resolveMaterialWithTheme()&#10;(theme → instance → noun → discipline → default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="470" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="out" value="DTXLayer.setObjectMaterial / setObjectVisible&#10;（落地到 three.js 材质）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="600" width="380" height="60" as="geometry" />
        </mxCell>

        <mxCell id="prec" value="最终优先级（高 → 低）&#10;&#10;1. 选中 / 高亮（独立层，最高）&#10;2. colorRules（首条命中）&#10;3. instanceConfigs[refno]&#10;4. theme ownerSpec / owner 覆盖&#10;5. materialConfigs[noun]&#10;6. disciplineOverrides[spec]（仅色）&#10;7. defaultMaterial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="80" width="250" height="220" as="geometry" />
        </mxCell>

        <mxCell id="rulemodel" value="ColorRule&#10;{ name, enabled?, when, color?, opacity?, metalness?, roughness?, hidden? }&#10;&#10;when（维度内 OR，维度间 AND，省略=通配）&#10;nouns / owners / specs / purposes / refnos / refnoPrefix / namePattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="200" width="560" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="src" target="apply"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="apply" target="resolve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="resolve" target="dec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dec" target="match"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="命中" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="match" target="hit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="未命中" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="match" target="fallback"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="否（回退）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dec" target="fallback"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="hit" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="fallback" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
