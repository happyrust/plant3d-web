{
  "version": "2.8",
  "children": [
    {
      "type": "frame",
      "id": "canvas2",
      "x": 0,
      "y": 0,
      "name": "Frame",
      "clip": true,
      "width": 800,
      "height": 1100,
      "fill": "#ffffff",
      "layout": "none"
    },
    {
      "type": "frame",
      "id": "psRoot",
      "x": 0,
      "y": 0,
      "name": "2D管道草图面板",
      "width": 340,
      "fill": "#ffffff",
      "cornerRadius": 8,
      "stroke": {
        "align": "inside",
        "thickness": 1,
        "fill": "#e2e8f0"
      },
      "effect": {
        "type": "shadow",
        "shadowType": "outer",
        "color": "#0000000f",
        "offset": {
          "x": 0,
          "y": 4
        },
        "blur": 16
      },
      "layout": "vertical",
      "gap": 0,
      "padding": 0,
      "children": [
        {
          "type": "frame",
          "id": "psHeader",
          "name": "header",
          "width": "fill_container",
          "fill": "#f8fafc",
