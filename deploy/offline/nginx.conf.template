# Plant3D-Web 离线部署版 Nginx 配置 (Windows)
# 适配内网部署，开箱即用
#
# 使用方式：
#   1. 修改下面的后端地址为实际的 gen-model 后端地址
#   2. 运行 ../start.bat 启动

worker_processes  1;

error_log  logs/error.log warn;
pid        logs/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    # WebSocket 升级连接映射
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  logs/access.log  main;

    sendfile        on;
    keepalive_timeout  65;

    # ============================================================
    # 上游后端定义 - 默认 gen-model (aios-database) 地址
    # ============================================================
    upstream gen_model_backend {
        server 127.0.0.1:8022;
        keepalive 32;
    }

    server {
        # 监听端口 - 前端访问端口
        # 同时监听 3100 端口（兼容 PowerPMS 历史配置）
        listen       80;
        listen       3100;
        server_name  localhost;

        # 静态文件根目录 - 相对于 nginx.exe 所在目录的 ../www
        root   ../www;
        index  index.html;

        # 字符集
        charset utf-8;

        # Vite 入口 HTML 必须每次 revalidate，避免旧 index.html 继续引用旧 hash bundle
        location = /index.html {
            try_files /index.html =404;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
        }

        # 前端应用 / SPA fallback
        location / {
            try_files $uri $uri/ /index.html;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
        }

        # pms-review-simulator 调试页（与主站同包）
        location = /pms-review-simulator.html {
            try_files /pms-review-simulator.html =404;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        }

        # hash 命名的静态资源可以长期缓存
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|wasm|json)$ {
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, immutable" always;
        }

        # API 反向代理：全部 /api（含 /api/v1）→ gen-model
        location /api {
            proxy_pass http://gen_model_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 300s;
            proxy_buffering off;
            client_max_body_size 50m;
        }

        # 校审附件下载 → gen-model
        location ^~ /files/ {
            proxy_pass http://gen_model_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            client_max_body_size 50m;
        }

        # 版本信息接口（本地文件）
        location = /version.json {
            try_files /version.json =404;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        }

        # Gzip 压缩
        gzip on;
        gzip_vary on;
        gzip_proxied any;
        gzip_comp_level 6;
        gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript application/wasm;
        gzip_min_length 1000;
    }
}
